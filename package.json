{
  "name": "fertis-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Fertis - Backend API",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:create": "node scripts/create-db.js",
    "seed": "node src/seeders/run.js",
    "test": "node --test --test-concurrency=1",
    "build:admin": "npm --prefix ../admin run build"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sanitize-html": "^2.18.0",
    "sequelize": "^6.37.8",
    "slugify": "^1.6.9",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
