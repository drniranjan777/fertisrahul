APP_PORT=5200
NODE_ENV=development

# JWT (production: at least 32 random characters)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE_IN=7d

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=fertis
DB_PASSWORD=fertis_dev_password
DB_NAME=fertis_db
DB_NAME_TEST=fertis_db_test

# Seeder (admin is created only if this email does not exist yet)
SEED_ON_STARTUP=true
ADMIN_NAME=Fertis Admin
ADMIN_EMAIL=admin@fertis.in
ADMIN_PASSWORD=Admin@123

# CORS (comma-separated origins; * for all)
CORS_ORIGIN=*

# Set true when running behind a reverse proxy (nginx, load balancer)
TRUST_PROXY=false

# Login brute-force protection (failed attempts per IP per window)
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10

# Uploaded product images and PDFs (default: backend/uploads)
# UPLOAD_DIR=
